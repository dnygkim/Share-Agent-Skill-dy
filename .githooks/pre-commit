#!/bin/sh
# pre-commit — 민감자료 · 민감정보 커밋 차단 (에이전트 공통)
# 활성화: git config core.hooksPath .githooks   (clone 직후 1회)
# 검사는 guard.py 가 한다(스테이징된 줄 · 파일 이름 · 새 바이너리):
#  - 경로 차단: agent/*/input|output|_workspace(.gitkeep 제외), agent/*/examples/*.html(과거 고객 완성본), .env, .corpus/, 개인키 · 자격 증명 파일
#  - 내용 차단: 토큰 · 개인키 · 비밀값 · 주민번호, 공개 범위(공유 리포 · 미러 대상 경로)는 연락처 · 고객/사업/사람 이름 · 내부 링크 · 로컬 경로 · 검사할 수 없는 새 바이너리까지
#  - 샘플로 확인받은 파일(허용 목록의 p:경로지문 · guard.py exempt)은 경로 · 이름 · 바이너리 차단 없이 토큰 · 개인키만 본다
# 2026-11-26: 예전의 경로 정규식 검사(셸)를 guard.py 로 합쳤다 — 샘플 예외를 한곳에서 판정하려고. --no-verify 우회 금지.
. "$(dirname "$0")/_guard.sh"
guard_run staged || exit 1
exit 0
